<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    android:background="@drawable/light_blue_card"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:id="@+id/addressTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Адрес:"
        android:textColor="@color/main_blue"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/summaryTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Суммарные показания: 519,98"
        android:textColor="@color/black"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tariff1TextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Тариф 1: 352,6"
        android:textColor="@color/black"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tariff2TextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Тариф 2: 51,64"
        android:textColor="@color/black"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tariff3TextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Тариф 3: 38,35"
        android:textColor="@color/black"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tariff4TextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Тариф 4: 77,4"
        android:textColor="@color/black"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/dateTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Дата: 15.09.2025 14:50:53"
        android:textColor="@color/text_gray"
        android:textSize="19sp" />

    <LinearLayout
        android:id="@+id/copyButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/archive_date_field"
        android:gravity="center"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/ic_copy_blue"
            app:tint="@color/main_blue" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Скопировать"
            android:textColor="@color/main_blue"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>